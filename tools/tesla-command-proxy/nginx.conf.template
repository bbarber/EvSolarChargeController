# Fronts tesla-http-proxy so Container Apps' plain-HTTP ingress can reach its mandatory-TLS listener.

server {
    listen 8080;
    server_name _;

    # Container Apps ingress is public. The Fleet API bearer token is already required downstream,
    # but a shared secret keeps unauthenticated traffic from ever reaching the signing proxy.
    if ($http_x_proxy_secret != "${PROXY_SHARED_SECRET}") {
        return 403;
    }

    location /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        proxy_pass https://127.0.0.1:4443;

        # The loopback listener uses a self-signed certificate generated at container start; there
        # is no third party on this hop to authenticate.
        proxy_ssl_verify off;
        proxy_ssl_server_name on;

        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_pass_request_headers on;

        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }
}
