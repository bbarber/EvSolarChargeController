<!--
  Serves the Tesla third-party public key.

  Tesla requires the application's EC public key to be reachable at
  https://<application-domain>/.well-known/appspecific/com.tesla.3p.public-key.pem
  before a virtual key can be paired with a vehicle. The key is public by definition, so it is
  held in an APIM named value and returned inline rather than proxied to a backend.
-->
<policies>
  <inbound>
    <base />
    <return-response>
      <set-status code="200" reason="OK" />
      <set-header name="Content-Type" exists-action="override">
        <value>application/x-pem-file</value>
      </set-header>
      <set-header name="Cache-Control" exists-action="override">
        <value>public, max-age=3600</value>
      </set-header>
      <set-body>@((string)context.Variables.GetValueOrDefault("publicKeyPem", "{{tesla-public-key-pem}}"))</set-body>
    </return-response>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
