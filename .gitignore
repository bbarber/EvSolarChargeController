# Build output
bin/
obj/
out/
publish/
*.user
*.suo

# Azure Functions
local.settings.json
.azurefunctions/
azurite/
__azurite*
__blobstorage__/
__queuestorage__/
.debug/

# Secrets — never commit these
.secrets/
*.pem
# The Tesla third-party *public* key is meant to be served publicly. Narrowly re-allowed here so
# that a stray copy of the private key elsewhere in the tree still cannot be committed.
!site/.well-known/appspecific/com.tesla.3p.public-key.pem
*.pfx
*.p12
.env
.env.*
secrets.json
*.secrets.bicepparam

# Bicep build output
*.bicep.json
infra/**/*.json
!infra/**/*.parameters.json

# IDE
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store

# Test output
TestResults/
coverage/
*.trx
*.coverage

# Terraform (OCI)
infra/oracle/.terraform/
infra/oracle/*.tfstate
infra/oracle/*.tfstate.*
infra/oracle/*.tfvars
infra/oracle/crash.log

# Deployment secrets
deploy/.env
deploy/secrets/
deploy/fleet-telemetry/config.json
deploy/fleet-telemetry/*.pem
